# 1. Đọc file thiết kế SystemVerilog
read_verilog -sv rtl/moving_average_filter.sv

# 2. Đặt module gốc (Top module)
hierarchy -check -top moving_average_filter

# 3. Chạy quy trình tổng hợp chung thành các cổng logic cơ bản
synth -top moving_average_filter

# 4. In ra bảng thống kê tài nguyên sử dụng
stat